<?xml version="1.0" encoding="utf-8"?>
<!-- Primer plano del icono adaptativo (y capa monocroma): carrito blanco.
     Mismo dibujo que assets/icon-only.svg, en sus coordenadas (lienzo de 1024 = zona visible de 72 dp).
     El grupo exterior lo coloca en el lienzo de 108 dp: escala 72/1024 y margen de 18 dp. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.0703125"
        android:scaleY="0.0703125"
        android:translateX="18"
        android:translateY="18">
        <!-- equivale a translate(512 512) scale(0.9) translate(-505 -561) del SVG -->
        <group
            android:scaleX="0.9"
            android:scaleY="0.9"
            android:translateX="57.5"
            android:translateY="7.1">
            <!-- Cesta. El recorte deja dos ranuras: van en sentido contrario al rectángulo, así que son huecos -->
            <group>
                <clip-path android:pathData="M0,0 H1024 V1024 H0 Z M352,469 A13,13 0 0,0 352,495 H770 A13,13 0 0,0 770,469 Z M370,535 A13,13 0 0,0 370,561 H748 A13,13 0 0,0 748,535 Z" />
                <path
                    android:fillColor="#FFFFFF"
                    android:pathData="M324,400 L800,400 L752,610 L374,610 Z"
                    android:strokeColor="#FFFFFF"
                    android:strokeLineJoin="round"
                    android:strokeWidth="48" />
            </group>
            <!-- Asa, lateral y base -->
            <path
                android:pathData="M210,300 H300 L395,700 H745"
                android:strokeColor="#FFFFFF"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:strokeWidth="48" />
            <!-- Ruedas -->
            <path
                android:fillColor="#FFFFFF"
                android:pathData="M394,800 A46,46 0 1,0 486,800 A46,46 0 1,0 394,800 Z M654,800 A46,46 0 1,0 746,800 A46,46 0 1,0 654,800 Z" />
        </group>
    </group>
</vector>
